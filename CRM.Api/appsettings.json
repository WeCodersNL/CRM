{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=CRM-db;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "EmailConfiguration": {
    "FromName": "CRM Web Application",
    "FromEmail": "mail@wecoders.nl",
    "SmtpServer": "mail.wecoders.nl", // "smtp.gmail.com"
    "Port": 587,
    "UserName": "",
    "Password": ""
  },
  "TokenConfiguration": {
    "Subject": "JWTAuthToken",
    "SecretKey": "K17T6p+mYlBuIll6EOQDUmAdM6xmzeHOpE+O35zsAvw=",
    "Issuer": "https://localhost:7023",
    "Audience": "https://localhost:7212",
    "TokenExpiry": 2,
    "RefreshTokenExpiryDays": 7,
    "MaxRefreshTokenAttempts": 3
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "CRM.Api": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "ApplicationDbContextConnection",
          "sinkOptionsSection": {
            "tableName": "Logger",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "batchPeriod": "0.00:00:15"
          },
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "UserEmail",
                "DataType": "varchar",
                "DataLength": 450,
                "AllowNull": true
              },
              {
                "ColumnName": "UserIP",
                "DataType": "varchar",
                "DataLength": 20,
                "AllowNull": true
              },
              {
                "ColumnName": "RequestPath",
                "DataType": "varchar",
                "DataLength": 450,
                "AllowNull": true
              },
              {
                "ColumnName": "StatusCode",
                "DataType": "int",
                "AllowNull": true
              },
              {
                "ColumnName": "Elapsed",
                "DataType": "bigint",
                "AllowNull": true
              }
            ]
          }
        }
      }
    ]
  }
}