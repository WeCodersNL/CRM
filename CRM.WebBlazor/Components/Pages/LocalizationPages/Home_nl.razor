<PageTitle>Startpagina</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-12 px-4">

    <MudText Typo="Typo.h3" GutterBottom="true" Color="Color.Primary">
        Bouw echte toepassingen met vertrouwen
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-6">
        Bij <MudText Typo="Typo.body1" Color="Color.Secondary" Inline="true">CRM Application</MudText>, geven we niet alleen les — we bouwen samen.
        Volg onze YouTube-serie en GitHub-repository terwijl we stap voor stap een krachtige SaaS webapplicatie ontwikkelen met de nieuwste technologieën uit het .NET-ecosysteem.
    </MudText>

    <MudList T="string" Dense="true" Class="mb-6">
        <div class="mud-list-item d-flex align-center py-2 px-4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Color="Color.Success" />
            <MudText Typo="Typo.body1">Perfect voor beginners én gevorderden</MudText>
        </div>
        <div class="mud-list-item d-flex align-center py-2 px-4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Color="Color.Success" />
            <MudText Typo="Typo.body1">Realistische architectuur en code</MudText>
        </div>
        <div class="mud-list-item d-flex align-center py-2 px-4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Color="Color.Success" />
            <MudText Typo="Typo.body1">Leren binnen een community</MudText>
        </div>
        <div class="mud-list-item d-flex align-center py-2 px-4">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" Color="Color.Success" />
            <MudText Typo="Typo.body1">Live-demo beschikbaar</MudText>
            <MudText Typo="Typo.caption" Class="mx-3 mt-1">Binnenkort beschikbaar</MudText>
        </div>
    </MudList>

    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="text-center fst-italic">
        Jouw volgende stap begint hier.
    </MudText>

</MudContainer>